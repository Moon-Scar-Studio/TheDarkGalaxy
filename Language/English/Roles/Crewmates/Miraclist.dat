# Assignable

"role.miraclist.name" : "Miraclist"
"role.miraclist.short" : "神迹"
"role.miraclist.blurb" : "「你我所亲手缔造的奇迹」"
"role.miraclist.doc" : "你拥有「神迹」技能，可以在会议上对一人使用，使其成为「神谕者」。"
"role.miraclist.ability.title" : "固有能力【神迹创造】"
"role.miraclist.ability.main" : "你可以通过<var>神视</var>标记一名「神谕者」。<br>如果神谕者进行了击杀，且神谕者不是船员，那么<var>%PENALTY%</var><br>在<var>%CONDITION%</var>，神谕者会蜕变为「奇迹」，之后，你可以使用<b>命途编织</b>，从<var>%COUNT%</var>个船员职业中为其选择新职业。<br><var>%PUBLIC%</var><br><var>%SEEDNOTIFY%</var>"
"role.miraclist.doc.divinesight" : "<title>神视</title>在会议上选择一人标记为「神谕者」。<br><var>你只能拥有一名神谕者。</var>"
"role.miraclist.doc.fateweave" : "<title>命途编织</title>从<var>%COUNT%</var>个船员职业中选择一个，作为奇迹的新职业。<br><var>%PUBLIC%</var>"
"role.miraclist.tips" : "· 命途只能选择船员职业。<br>· 神谕者成为奇迹后，你才能使用命途编织。<br>· <var>%SEED%</var><br>· <var>%SEEDNOTIFY%</var><br>· <var>%MIRACLENOTIFY%</var>"
"role.miraclist.fateweave.tip" : "选择一名船员职业，作为奇迹的新命途。"
"role.miraclist.fateweave.empty" : "当前没有可供选择的命途。"
"role.miraclist.oracle.selected" : "神谕者已经选定。"
"role.miraclist.oracle.died" : "你感觉到，神谕者死亡了。"
"role.miraclist.oracle.killed" : "神谕者击杀了非船员，神迹之力消散了。"
"role.miraclist.miracle.created" : "神谕者已经蜕变为奇迹。"
"role.miraclist.miracle.died" : "你感觉到，奇迹死亡了。"
"role.miraclist.seed.died" : "你感觉到，神种死亡了。"

"role.miraclist.doc.condition.tasks" : "完成全部任务后"
"role.miraclist.doc.condition.meeting" : "经过%MEETING%轮后"
"role.miraclist.doc.public.true" : "命途编织后，你的身份会公开。"
"role.miraclist.doc.public.false" : "命途编织后，你的身份不会公开。"
"role.miraclist.doc.penalty.true" : "你会失去神迹之力并成为船员。"
"role.miraclist.doc.penalty.false" : "你会失去神迹之力，但不会成为船员。"
"role.miraclist.doc.seed.true" : "奇迹可以选择一位神种。"
"role.miraclist.doc.seed.false" : "奇迹不能选择神种。"
"role.miraclist.doc.seednotify.true" : "神种死亡后，你会收到提示。"
"role.miraclist.doc.seednotify.false" : "神种死亡后，你不会收到提示。"
"role.miraclist.doc.miraclenotify.true" : "奇迹死亡后，你会收到提示。"
"role.miraclist.doc.miraclenotify.false" : "奇迹死亡后，你不会收到提示。"

"role.oraclist.name" : "神谕者"
"role.oraclist.short" : "谕"
"role.oraclist.generalBlurb" : "你是神迹者选中的神谕者。"
"role.oraclist.doc" : "你是被神迹者选中的神谕者。<br><var>神迹者正在注视着你。</var>"
"role.oraclist.tips" : "· 若你击杀了非船员，神迹者会根据设置承受反噬。"

"role.miracle.name" : "奇迹"
"role.miracle.short" : "奇迹"
"role.miracle.generalBlurb" : "你是神迹者亲手缔造的奇迹。"
"role.miracle.doc" : "你是神迹者亲手缔造的奇迹。<br><var>%SEED%</var>"
"role.miracle.tips" : "· 你可以选择一位存活玩家成为神种。<br>· <var>%NOTIFY%</var>"
"role.miracle.seed.chosen" : "神种已经选定。"
"role.miracle.doc.seed.true" : "你可以选择一位存活玩家成为神种。"
"role.miracle.doc.seed.false" : "你不能选择神种。"
"role.miracle.doc.notify.true" : "你死亡后，神迹者会收到提示。"
"role.miracle.doc.notify.false" : "你死亡后，神迹者不会收到提示。"

"role.divineseed.name" : "神种"
"role.divineseed.short" : "种"
"role.divineseed.generalBlurb" : "奇迹之种"
"role.divineseed.doc" : "你是奇迹选中的神种。<br><var>%NOTIFY%</var>"
"role.divineseed.tips" : "· 你是奇迹选中的特殊存在。"
"role.divineseed.doc.notify.true" : "你死亡后，神迹者会收到提示。"
"role.divineseed.doc.notify.false" : "你死亡后，神迹者不会收到提示。"

"role.publicmiraclist.name" : "公开的神迹者"
"role.publicmiraclist.short" : "神迹"
"role.publicmiraclist.doc" : "你的身份已经公开。<br><var>你仍然保留神迹者的私聊频道。</var>"

# Options

"options.role.miraclist.detail" : "神迹者可以选择一名神谕者，神谕者在一定条件后蜕变为奇迹。<br>神迹者可以为奇迹选择一个新职业，并且奇迹可以招募一位神种。<br>神谕者、奇迹或神种死亡时，神迹者获得提示。"
"options.role.miraclist.HasPrivateChat" : "启用私聊"
"options.role.miraclist.NeedMeetingCount" : "神谕者蜕变所需会议数"
"options.role.miraclist.CantBeGuess" : "神迹者不可被猜测"
"options.role.miraclist.PublicRole" : "命途编织后公开身份"
"options.role.miraclist.FateWeaveCD" : "命途编织冷却"
"options.role.miraclist.BeMiracleType" : "神谕者蜕变方式"
"options.role.miraclist.BeMiracleType.DoAllTasks" : "Do all tasks"
"options.role.miraclist.BeMiracleType.MeetingCount" : "经过指定会议数"
"options.role.miraclist.NeedCrew" : "神谕者必须为船员"
"options.role.miraclist.PreventDemotion" : "神谕者击杀非船员时不转为船员"
"options.role.miraclist.PreventDemotion.detail" : "开启后，神谕者击杀非船员时，你仍会失去神迹之力，但不会变成船员。"
"options.role.miraclist.RoleFilter" : "命途职业池"
"options.role.miraclist.RoleCount" : "命途候选数量"
"options.role.miraclist.CanChooseSeed" : "奇迹可以选择神种"
"options.Miracle.TellMiraclist" : "奇迹死亡时提示神迹者"
"options.DivineSeed.HasPrivateChat" : "启用神种私聊"
"options.DivineSeed.TellMiraclist" : "神种死亡时提示神迹者"

