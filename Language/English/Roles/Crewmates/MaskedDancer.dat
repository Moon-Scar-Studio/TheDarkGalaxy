# Assignable

"role.maskeddancer.name" : "MaskedDancer"
"role.maskeddancer.short" : "Md"
"role.maskeddancer.blurb" : "跟我一起共舞吧？"

# Document

"role.maskeddancer.doc" : "邀请三名玩家参加舞会。在下一轮会议结束后可开启舞会"
"role.maskeddancer.ability.title" : "<b>固有能力【假面舞会】</b>"
"role.maskeddancer.ability.main" : "可以使用<b>邀请</b>来邀请三人。<br>邀请三人并且本轮结束后、可以<b>开启舞会</b><br>选择的人中，如果有两个相同阵营且这个阵营不是中立，那么击杀阵营不同者。<br>如果有两个中立阵营，那么<var>%NEU%</var><br>如果三个阵营均有，那么随机死一个被邀请者。<br>其余情况下，假面舞者自杀。"
"role.maskeddancer.doc.invite" : "<b>邀请</b><br>邀请一人来到舞会"
"role.maskeddancer.doc.start" : "<b>开启舞会</b><br>邀请三人后可开启舞会,最多使用<var>%USES%</var>次。"
"role.maskeddancer.doc.neu.0" : "随机击杀一个中立被邀请者。"
"role.maskeddancer.doc.neu.1" : "击杀非中立的被邀请者。"
"role.maskeddancer.tips" : "· Add by <b>The Dark Galaxy</b>."

# Options

"options.role.maskeddancer.maxuses" : "舞会最大使用次数"
"options.role.maskeddancer.invitecooldown" : "邀请冷却"
"options.role.maskeddancer.startcooldown" : "开始冷却"
"options.role.maskeddancer.neu" : "双中立处理方式"
"options.role.maskeddancer.neu.killrandomneu" : "随机击杀被邀请中立"
"options.role.maskeddancer.neu.killrandomnoneu" : "击杀非中立被邀请者"
"options.role.maskeddancer.detail" : "假面舞者可以邀请三人并且开启舞会。<br>根据被邀请者的阵营来决定舞会效果。"

