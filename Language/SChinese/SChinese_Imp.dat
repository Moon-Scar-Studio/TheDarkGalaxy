"role.incinerator.name" : "焚化工"
"role.incinerator.short" : "焚"
"role.incinerator.blurb" : "我会为你们带来一场宏大的葬礼！"
"options.role.incinerator.detail" : "焚化工可以通过处理来引爆尸体。"
"role.incinerator.doc" : "你可以处理尸体并且引爆。"
"role.incinerator.ability.title" : "固有能力【锅炉准备】"
"role.incinerator.ability.main" : "你可以处理尸体，使其可以被引爆，炸死附近的所有人。如果处理过的尸体被吃掉，引爆则炸死食用者。"
"role.incinerator.tips" : "· 该职业灵感来源于<b>「GoodEndGambler」</b>，由<b>The Dark Galaxy</b>添加。"

"role.incinerator.doc.rig" : "<title>处理</title>处理一个尸体<var>%RIGTIME%秒</var>%CANTMOVE%<br><var>最多可用%RIGMU%次。</var>"
"role.incinerator.doc.detonate" : "<title>引爆</title>处理尸体后，可以<var>%NEEDPOS%</var>。<br>引爆可以炸死<var>%OTHER%</var>。<br>引爆范围为<var>%EXPRAD%x。</var><br>%ENABLEWAR%引爆在<var>%DUR%</var>秒后生效。"
"role.incinerator.doc.drag" : "<title>拖拽</title><var>你可以拖拽尸体</var>。"


"role.incinerator.doc.canboomother.all" : "范围内所有的人"
"role.incinerator.doc.canboomother.self" : "范围内除了其他伪装者的人"
